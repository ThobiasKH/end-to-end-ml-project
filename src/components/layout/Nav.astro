---
import MotionToggle from "./MotionToggle.astro";

const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: "Home" },
  { href: base + "lab/rocket-reinforcement-learning/", label: "Rocket lab" },
  { href: "https://thobiashoivik.com/", label: "Personal website" },
];

const currentPath = Astro.url.pathname;

---

<MotionToggle />

<header class="site-nav">
  <a class="site-title" href={base}>Rocket RL</a>

  <nav class="nav-links" aria-label="Main navigation">
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          class:list={[
            "nav-link",
            (link.href === base ? currentPath === base : currentPath.startsWith(link.href)) && "active",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .site-title {
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .nav-link {
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  @media (min-width: 720px) {
    .site-nav {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
